<?xml version="1.0"?>
<ruleset name="BMLT Literature Manager">
	<description>Correctness and security rules: WordPress escaping, nonce, input, SQL and i18n rules for the plugin;
	PHP 7.4+ compatibility everywhere. (Formatting is not enforced.)</description>

	<file>bmlt-literature-manager</file>
	<file>fake-bmlt</file>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<config name="testVersion" value="7.4-"/>
	<config name="minimum_wp_version" value="5.9"/>

	<rule ref="Generic.PHP.Syntax"/>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.Security">
		<exclude-pattern>fake-bmlt/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.DB.PreparedSQL"/>
	<rule ref="WordPress.DB.PreparedSQLPlaceholders"/>
	<rule ref="WordPress.WP.I18n">
		<exclude-pattern>fake-bmlt/*</exclude-pattern>
		<properties>
			<property name="text_domain" type="array"><element value="bmlt-literature-manager"/></property>
		</properties>
	</rule>
	<rule ref="WordPress.PHP.DevelopmentFunctions">
		<exclude-pattern>fake-bmlt/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions">
		<exclude-pattern>fake-bmlt/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.PHP.RestrictedPHPFunctions"/>
	<rule ref="WordPress.WP.AlternativeFunctions">
		<exclude-pattern>fake-bmlt/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.CronInterval"/>
	<rule ref="WordPress.WP.GlobalVariablesOverride">
		<!-- Views are included from inside a method (Front::render_view, Admin::view): their variables are local. -->
		<exclude-pattern>bmlt-literature-manager/*/views/*</exclude-pattern>
	</rule>
	<rule ref="Squiz.PHP.Eval"/>
	<rule ref="Generic.PHP.BacktickOperator"/>
</ruleset>
