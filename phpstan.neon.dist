parameters:
    level: 5
    phpVersion: 70400
    paths:
        - bmlt-literature-manager
        - fake-bmlt
    excludePaths:
        - bmlt-literature-manager/*/views/*
    bootstrapFiles:
        - tests/phpstan-constants.php
    treatPhpDocTypesAsCertain: false
    dynamicConstantNames:
        - BMLT_LIT_DATA_DIR
        - BMLT_LIT_SMTP_PASSWORD
        - BMLT_LIT_LOCK_METHOD
        - WP_DEBUG
        - WP_DEBUG_LOG
    # Files are written, renamed and re-read: calls with the same arguments may return different results.
    rememberPossiblyImpureFunctionValues: false
